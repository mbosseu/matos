---
import Layout from "../layouts/Layout.astro"
import HeroCarousel from "../components/HeroCarousel.tsx"
import { SITE } from "../data/nav.js"
import { PRODUCTS } from "../data/products.js"

const bySlug = (slug) => PRODUCTS.find((p) => p.slug === slug)

const slides = [
  {
    id: "hero-boxe",
    image: (bySlug("gants-de-boxe-legacy-horse-hair-noir") || PRODUCTS[0]).image,
    alt: (bySlug("gants-de-boxe-legacy-horse-hair-noir") || PRODUCTS[0]).name,
    title: "Le matos des combattants",
    text: "Gants de boxe, gants MMA, protections et équipement de sports de combat. Catalogue Metal Boxe. Vente bientôt ouverte — inscris-toi pour être prévenu.",
    cta: "Voir les gants",
    href: "/gants-de-boxe",
  },
  {
    id: "hero-mma",
    image: (bySlug("gants-mma-the-shell-noir") || PRODUCTS[1]).image,
    alt: (bySlug("gants-mma-the-shell-noir") || PRODUCTS[1]).name,
    title: "Gants MMA, main libre",
    text: "Sparring et combat. La mousse encaisse, les doigts restent libres pour les saisies.",
    cta: "Voir les gants MMA",
    href: "/gants-mma",
  },
  {
    id: "hero-protect",
    image: (bySlug("protege-tibias-pieds-mma-legacy") || PRODUCTS[2]).image,
    alt: (bySlug("protege-tibias-pieds-mma-legacy") || PRODUCTS[2]).name,
    title: "Ce qui te laisse revenir",
    text: "Tibias, casques, dents. La protection sans bloquer les déplacements.",
    cta: "Voir les protections",
    href: "/protections-mma",
  },
]

const featured = [
  {
    p: bySlug("gants-de-boxe-ergo90-miami-vibe-noir"),
    eyebrow: "Gants de boxe",
    title: "Le premier matos. Celui qui reste dans le sac.",
    href: "/gants-de-boxe",
  },
  {
    p: bySlug("gants-mma-the-shell-noir"),
    eyebrow: "Gants MMA",
    title: "Sparrer sans se casser les mains.",
    href: "/gants-mma",
  },
  {
    p: bySlug("protege-tibias-pieds-mma-legacy"),
    eyebrow: "Protections",
    title: "Tibias, casque, dents : le trio qui sauve les séances.",
    href: "/protections-mma",
  },
  {
    p: bySlug("casque-barre-polycarbonate-noir"),
    eyebrow: "Équipement débutant",
    title: "S’équiper pour le premier cours, sans se tromper.",
    href: "/equipement-debutant",
  },
].filter((x) => x.p)

const iconic = [
  { href: "/gants-de-boxe", label: "Gants de boxe", img: PRODUCTS[0].image },
  { href: "/gants-mma", label: "Gants MMA", img: PRODUCTS.find((p) => p.slug === "gants-mma-hybrid").image },
  { href: "/protections-boxe", label: "Casques", img: PRODUCTS.find((p) => p.slug.includes("casque")).image },
  { href: "/protections-mma", label: "Tibias", img: PRODUCTS.find((p) => p.slug.includes("tibias-pieds-mma-legacy")).image },
  { href: "/textile-combat", label: "Shorts", img: PRODUCTS.find((p) => p.type === "textile").image },
  { href: "/accessoires-boxe", label: "Accessoires", img: PRODUCTS.find((p) => p.slug.includes("bandes")).image },
  { href: "/equipement-debutant", label: "Débutant", img: PRODUCTS.find((p) => p.slug.includes("enfant") && p.type === "gants").image },
  { href: "/guides-achat", label: "Guides", img: PRODUCTS.find((p) => p.slug.includes("apollon")).image },
]
const orgLd = {
  "@context": "https://schema.org",
  "@type": "Store",
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  slogan: SITE.tagline,
}
---

<Layout title={`Matos de boxe | ${SITE.tagline}`} description={SITE.description}>
  <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
  <HeroCarousel client:load slides={slides} />

  <section class="featured">
    {
      featured.map((c) => (
        <article class="card-feature">
          <img src={c.p.image} alt={`${c.eyebrow} — ${c.p.name}`} />
          <div class="copy">
            <div class="eyebrow">{c.eyebrow}</div>
            <h3>{c.title}</h3>
            <div class="actions">
              <a class="btn" href={c.href}>
                Découvrir
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </section>

  <section class="banner">
    <img src={PRODUCTS.find((p) => p.slug === "gants-mma-combat-legacy").image} alt="Gants MMA Legacy Metal Boxe" />
    <div class="copy">
      <h2>
        Gants MMA Legacy
        <br />
        Sparring et combat
      </h2>
      <p>La ligne Metal Boxe pour ceux qui enchaînent les rounds.</p>
      <a class="btn" href="/gants-mma">Voir les gants MMA</a>
    </div>
  </section>

  <section class="iconic">
    <h2>Les indispensables</h2>
    <div class="iconic-grid">
      {
        iconic.map((item) => (
          <a class="iconic-item" href={item.href}>
            <img src={item.img} alt={item.label} />
            <span>{item.label}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="page" style="padding-top:24px">
    <h2 class="page-title">Pourquoi matos-de-boxe.fr</h2>
    <div class="prose">
      <p>
        On équipe les pratiquants, pas les vitrines. Ici tu trouves du <strong>matos de boxe</strong> et du
        <strong>matériel MMA</strong> Metal Boxe : gants, protections, textile. Les fiches sont écrites comme on
        parle au bord du ring — tailles, usage, niveau.
      </p>
      <p>
        La boutique prépare son ouverture nationale. Les articles sont visibles, les commandes pas encore ouvertes.
        En attendant, lis les <a href="/guides-achat">guides d'achat</a> et laisse ton e-mail sur les fiches qui t’intéressent.
      </p>
    </div>
  </section>
</Layout>
