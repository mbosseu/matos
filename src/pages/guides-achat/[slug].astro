---
import Layout from "../../layouts/Layout.astro"
import { GUIDES } from "../../data/guides.js"

export function getStaticPaths() {
  return GUIDES.map((g) => ({ params: { slug: g.slug } }))
}

const guide = GUIDES.find((g) => g.slug === Astro.params.slug)
if (!guide) throw new Error("Guide introuvable")

function toHtml(md) {
  const withMarks = md
    .replace(/^### (.*)$/gm, "<h3>$1</h3>")
    .replace(/^## (.*)$/gm, "<h2>$1</h2>")
    .replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>")
    .replace(/\[(.*?)\]\((.*?)\)/g, '<a href="$2">$1</a>')
  return withMarks
    .split(/\n\n+/)
    .map((p) => (p.startsWith("<h") ? p : `<p>${p.replace(/\n/g, "<br/>")}</p>`))
    .join("")
}

const html = toHtml(guide.body)
---

<Layout title={guide.title} description={guide.description}>
  <div class="page">
    <p class="crumb"><a href="/">Accueil</a> / <a href="/guides-achat">Guides</a></p>
    <h1 class="page-title">{guide.title}</h1>
    <div class="prose" set:html={html} />
  </div>
</Layout>
