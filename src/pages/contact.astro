---
import Layout from "../layouts/Layout.astro"
import ContactForm from "../components/ContactForm.tsx"
---

<Layout title="Contact" description="Contacter Matos de boxe pour une question catalogue, partenariat ou ouverture de la boutique.">
  <div class="page">
    <h1 class="page-title">Contact</h1>
    <p class="page-sub">Une question sur le matos, une salle à équiper, un partenariat Metal Boxe : écris-nous.</p>
    <ContactForm client:load />
    <p class="price-note">Le formulaire sera branché sur la boîte mail de la boutique avant l’ouverture des ventes.</p>
  </div>
</Layout>
